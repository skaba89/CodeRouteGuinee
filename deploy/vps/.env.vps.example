# Production CodeRoute sur le VPS — copier vers .env.vps (racine du dépôt) et
# remplir. .env.vps n'est JAMAIS commité (voir .gitignore).
# Générer chaque secret avec : openssl rand -hex 32

# ── Domaine public ───────────────────────────────────────────────
# En attendant le nom de domaine définitif : sous-domaine sslip.io de l'IPv4
# du VPS, ex. coderoute.203-0-113-10.sslip.io (HTTPS automatique par Caddy).
CODEROUTE_DOMAIN=coderoute.203-0-113-10.sslip.io

# ── Base de données (réseau Docker interne uniquement) ──────────
POSTGRES_DB=coderoute
POSTGRES_USER=coderoute
POSTGRES_PASSWORD=REMPLACER_PAR_UN_SECRET

# ── Sécurité (32 caractères minimum, tous différents) ───────────
SECRET_KEY=REMPLACER_PAR_UN_SECRET
CSRF_SECRET=REMPLACER_PAR_UN_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Exigé en production par /health/readiness (création encadrée de comptes admin).
ADMIN_REGISTRATION_TOKEN=REMPLACER_PAR_UN_SECRET

# Journal d'audit chaîné (HMAC) — clé à sauvegarder hors du VPS : sans elle,
# l'intégrité du journal ne peut plus être prouvée.
AUDIT_CHAIN_ENABLED=true
AUDIT_CHAIN_HMAC_KEY=REMPLACER_PAR_UN_SECRET

# ── Capacité (6 vCPU partagés avec Academy) ─────────────────────
WEB_CONCURRENCY=3
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ── Paiements : sandbox tant que les contrats opérateurs ne sont pas signés
MOBILE_MONEY_MODE=sandbox

# ── Notifications (facultatif) ──────────────────────────────────
BREVO_API_KEY=
EMAIL_FROM=noreply@example.org

# ── Supervision (facultatif) ────────────────────────────────────
SENTRY_DSN=
