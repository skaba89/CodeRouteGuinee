# CodeRoute Guinea Center Edge — exemple de configuration production P9
# Copier vers /etc/coderoute-edge/edge.env avec mode 0640 root:coderoute-edge.

CODEROUTE_EDGE_CENTRAL_URL=https://api.coderoute.gov.gn
CODEROUTE_EDGE_NODE_ID=<UUID_GATEWAY_ENROLE>
CODEROUTE_EDGE_CENTER_ID=<UUID_CENTRE_DNTT>
CODEROUTE_EDGE_PRIVATE_KEY_PATH=/etc/coderoute-edge/node-private-key.pem
CODEROUTE_EDGE_DB_PATH=/var/lib/coderoute-edge/edge.db
CODEROUTE_EDGE_STORAGE_KEY_PATH=/var/lib/coderoute-edge/storage.key
CODEROUTE_EDGE_MEDIA_DIR=/var/cache/coderoute-edge/media
CODEROUTE_EDGE_RELEASE_DIR=/opt/coderoute-edge/releases
CODEROUTE_EDGE_OPERATOR_TOKEN=<SECRET_LOCAL_32_CARACTERES_MINIMUM>
CODEROUTE_EDGE_ALLOWED_ORIGINS=https://coderoute.gov.gn
CODEROUTE_EDGE_PUBLIC_URL=https://edge-centre.example.gov.gn:8443
CODEROUTE_EDGE_TLS_CERT_PATH=/etc/coderoute-edge/tls/fullchain.pem
CODEROUTE_EDGE_TLS_KEY_PATH=/etc/coderoute-edge/tls/privkey.pem
CODEROUTE_EDGE_MAX_MEDIA_BYTES=52428800
CODEROUTE_EDGE_MAX_RELEASE_BYTES=536870912

# P9 — maintenance et updater transactionnel.
CODEROUTE_EDGE_MAINTENANCE_WINDOWS=sun@01:00-04:00
CODEROUTE_EDGE_MAINTENANCE_TIMEZONE=Africa/Conakry
CODEROUTE_EDGE_SYSTEMD_SERVICE=coderoute-edge.service
CODEROUTE_EDGE_HEALTHCHECK_TIMEOUT_SECONDS=60
CODEROUTE_EDGE_HEALTHCHECK_CA_PATH=/etc/coderoute-edge/tls/ca.pem
CODEROUTE_EDGE_RUNTIME_PYTHON=/usr/bin/python3

# Ne pas définir CODEROUTE_EDGE_SOFTWARE_VERSION en production normale.
# Le daemon lit la version réellement active dans releases/current/.release-state.json.
